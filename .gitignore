# Dependency directories
node_modules/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store

# Python / SCons
__pycache__/
*.pyc
.sconsign.dblite

# Godot Engine auto-generated files
.godot/
.godot/export_credentials.cfg
*.translation

# Godot user data (local saves, caches)
# These are intentionally committed: project.godot, scenes/, scripts/, shaders/, export_presets.cfg

# iOS / Godot export build output (regenerated via Export)
build/*
!build/ci_scripts/
!build/ci_scripts/**

# iOS plugin build intermediates (final binaries live in ios/plugins/)
ios/plugin_src/**/bin/
ios/plugin_src/**/*.o
